[Unit]
Description=Parent Tracker service (records screen time for the accounts you chose)
Documentation=https://github.com/samiferr/parent_tracker_ubuntu
After=systemd-logind.service dbus.service
Wants=systemd-logind.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/parent-trackerd --config /etc/parent-tracker/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Directories: /var/lib/parent-tracker (0700) and /run/parent-tracker (0755, so
# the per-session agent and the self-view client can reach the sockets).
StateDirectory=parent-tracker
StateDirectoryMode=0700
RuntimeDirectory=parent-tracker
RuntimeDirectoryMode=0755
ConfigurationDirectory=parent-tracker
ConfigurationDirectoryMode=0755

# The service runs as root so the accounts it observes cannot stop it or edit
# its files. The settings below only narrow what it can reach; they do not
# remove capabilities, because the desktop alert channel runs `notify-send`
# through `runuser` in the parent's own session.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/parent-tracker
# /run/user must stay reachable (a notification goes over the user's bus).
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Unix sockets (logind, agents, control) and the dashboard / alert channel.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
